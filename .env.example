# Copy to .env and fill in. `docker run --env-file .env ...` reads it. See the README's "Env vars" table.
# Print outgoing messages instead of sending, and skip the webhook signature check. Remove when going live.
DRY_RUN=1
# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Protects /admin, /orders/*/status, /users/*/reset. Open /admin?token=...
ADMIN_TOKEN=
# SQLite file. The Docker image already sets /data/lave.db (on the volume).
# DB_PATH=lave.db
# Optional LLM fallback that answers only from the YAML
# LLM_FALLBACK=1
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
